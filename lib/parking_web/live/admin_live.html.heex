<Layouts.app flash={@flash}>
  <div class="space-y-8 p-6">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-100">Admin: Permanente Nutzer</h1>
        <p class="text-sm text-gray-400">
          Nur über diesen Bereich darf man permanente Nutzerkarten einsehen.
        </p>
      </div>
      <div class="flex gap-3 items-center">
        <.form for={to_form(%{})} id="garage-selector-form" phx-change="select_garage">
          <.input
            type="select"
            id="garage-id-select"
            name="garage_id"
            value={@garage_id}
            options={Enum.map(@garages, &{&1.name, &1.id})}
            class="bg-gray-700 border border-gray-600 text-gray-100 text-sm rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </.form>
        <.link
          navigate={~p"/garage/#{@garage_id}"}
          class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition font-semibold"
        >
          ← Zurück zum Parkhaus
        </.link>
      </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
      <h2 class="text-xl font-bold text-gray-100 mb-4">Admin-Anmeldung</h2>
      <%= if @admin_authenticated do %>
        <div class="rounded-lg p-4 mb-4 border bg-green-900 border-green-700 text-green-100">
          <div class="flex items-start">
            <span class="material-icons text-xl mr-3 align-middle leading-none">
              check_circle
            </span>
            <p class="font-semibold">{@admin_message || "Bereit für den Zugriff"}</p>
          </div>
        </div>
        <div class="flex gap-3 mb-4">
          <button
            phx-click="refresh"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition duration-200"
          >
            <span class="material-icons align-middle text-base leading-none mr-1">refresh</span>Aktualisieren
          </button>
          <button
            phx-click="logout"
            class="bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded-lg transition duration-200"
          >
            <span class="material-icons align-middle text-base leading-none mr-1">logout</span>Abmelden
          </button>
        </div>
      <% else %>
        <%= if @admin_error do %>
          <div class="rounded-lg p-4 mb-4 border bg-red-900 border-red-700 text-red-100">
            <div class="flex items-start">
              <span class="material-icons text-xl mr-3 align-middle leading-none">warning</span>
              <p class="font-semibold">{@admin_error}</p>
            </div>
          </div>
        <% end %>
        <.form for={to_form(%{})} id="admin-login-form" phx-submit="login" class="space-y-4">
          <.input
            id="admin-password"
            name="admin_password"
            type="password"
            label="Admin-Passwort"
            placeholder="Admin-Passwort eingeben"
            class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            required
          />
          <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition duration-200">
            <span class="material-icons align-middle text-base leading-none mr-1">lock</span>Einloggen
          </button>
        </.form>
      <% end %>

      <%= if @admin_authenticated do %>
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 mt-6">
          <h3 class="text-lg font-bold text-gray-100 mb-4">
            Neuen permanenten Nutzer hinzufügen
          </h3>
          <%= if @admin_error do %>
            <div class="rounded-lg p-4 mb-4 border bg-red-900 border-red-700 text-red-100">
              <div class="flex items-start">
                <span class="material-icons text-xl mr-3 align-middle leading-none">warning</span>
                <p class="font-semibold">{@admin_error}</p>
              </div>
            </div>
          <% end %>
          <.form for={to_form(%{})} id="add-user-form" phx-submit="add_user" class="space-y-4">
            <.input
              id="user-name"
              name="name"
              type="text"
              label="Name"
              placeholder="Nutzername"
              class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              required
            />
            <button class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-lg transition duration-200">
              <span class="material-icons align-middle text-base leading-none mr-1">add</span>Nutzer hinzufügen
            </button>
          </.form>
        </div>
      <% end %>
    </div>

    <%= if @admin_authenticated do %>
      <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-gray-100">Permanente Nutzerliste</h2>
            <p class="text-sm text-gray-400">
              Hier können Admins die registrierten Nutzerkarten einsehen.
            </p>
          </div>
          <span class="text-xs text-gray-400">Nur für Administratoren</span>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm text-gray-200">
            <thead class="border-b border-gray-700 text-xs uppercase tracking-wider text-gray-400">
              <tr>
                <th class="px-3 py-2">Name</th>
                <th class="px-3 py-2">Karten UUID</th>
                <th class="px-3 py-2">Parkplatz</th>
                <th class="px-3 py-2">Status</th>
                <th class="px-3 py-2">Gesperrt</th>
                <th class="px-3 py-2">Miete bis</th>
                <th class="px-3 py-2">Aktionen</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
              <%= for user <- @perm_users do %>
                <tr class="hover:bg-gray-700/50">
                  <td class="px-3 py-3 font-medium">{user.name}</td>
                  <td class="px-3 py-3 font-mono break-all">{user.access_code}</td>
                  <td class="px-3 py-3">
                    <%= if user.is_parked do %>
                      <span class="font-mono">#{user.spot.number}</span>
                    <% else %>
                      <%= if user.spot do %>
                        <span class="text-gray-400 text-xs block mb-1">Aktuell: #{user.spot.number}</span>
                      <% end %>
                      <.form
                        for={to_form(%{})}
                        id={"assign-spot-form-#{user.id}"}
                        phx-submit="assign_spot"
                        class="flex gap-1 items-center"
                      >
                        <input type="hidden" name="user_id" value={user.id} />
                        <select
                          name="spot_id"
                          class="bg-gray-700 border border-gray-600 text-gray-100 text-xs rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        >
                          <option value="">— wählen —</option>
                          <%= for spot <- @unassigned_spots do %>
                            <option value={spot.id}>#{spot.number}</option>
                          <% end %>
                        </select>
                        <button
                          type="submit"
                          class="px-2 py-1 text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded transition"
                        >
                          OK
                        </button>
                      </.form>
                    <% end %>
                  </td>
                  <td class="px-3 py-3">
                    <span class={[
                      "inline-flex rounded-full px-2 py-1 text-xs font-semibold",
                      if(user.is_parked,
                        do: "bg-green-500/20 text-green-200",
                        else: "bg-yellow-500/20 text-yellow-200"
                      )
                    ]}>
                      {if user.is_parked, do: "Eingeparkt", else: "Bereit"}
                    </span>
                  </td>
                  <td class="px-3 py-3">
                    <span class={[
                      "inline-flex rounded-full px-2 py-1 text-xs font-semibold",
                      if(user.is_blocked,
                        do: "bg-red-500/20 text-red-200",
                        else: "bg-green-500/20 text-green-200"
                      )
                    ]}>
                      {if user.is_blocked, do: "Ja", else: "Nein"}
                    </span>
                  </td>
                  <td class="px-3 py-3 text-sm text-gray-200">
                    <%= case user.rent_paid_until do %>
                      <% nil -> %>
                        —
                      <% date -> %>
                        {Calendar.strftime(date, "%Y-%m-%d")}
                    <% end %>
                  </td>
                  <td class="px-3 py-3 space-x-2">
                    <button
                      phx-click="toggle_block"
                      phx-value-user_id={user.id}
                      class={"px-3 py-1 text-xs font-semibold rounded-lg transition duration-200 " <> if(user.is_blocked, do: "bg-green-600 hover:bg-green-700 text-white", else: "bg-red-600 hover:bg-red-700 text-white")}
                    >
                      {if user.is_blocked, do: "Entsperren", else: "Sperren"}
                    </button>
                    <button
                      phx-click="pay_rent"
                      phx-value-user_id={user.id}
                      class="px-3 py-1 text-xs font-semibold rounded-lg bg-blue-600 hover:bg-blue-700 text-white transition duration-200"
                    >
                      Miete zahlen
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
