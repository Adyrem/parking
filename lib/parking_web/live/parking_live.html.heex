<Layouts.app flash={@flash}>
  <div class="space-y-8 p-6">
    <%!-- Navigation --%>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-100">Parksystem - {@garage.name}</h1>
        <p class="text-sm text-gray-400">
          Ticketworkflow für Gelegenheitsnutzer und Kartenworkflow für Dauerparker.
        </p>
      </div>
      <div class="flex gap-3 items-center">
        <%!-- Garage Selector --%>
        <.form for={to_form(%{})} id="garage-selector-form" phx-change="select_garage">
          <.input
            type="select"
            id="garage-id-select"
            name="garage_id"
            value={@garage_id}
            options={Enum.map(@garages, &{&1.name, &1.id})}
            class="bg-gray-700 border border-gray-600 text-gray-100 text-sm rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </.form>
        <.link
          navigate={~p"/admin?garage_id=#{@garage_id}"}
          class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition font-semibold"
        >
          <span class="material-icons align-middle text-base leading-none mr-1">admin_panel_settings</span>Admin
        </.link>
        <.link
          navigate={~p"/stats?garage_id=#{@garage_id}"}
          class="px-4 py-2 bg-blue-700 hover:bg-blue-600 text-white rounded-lg transition font-semibold"
        >
          <span class="material-icons align-middle text-base leading-none mr-1">bar_chart</span>Statistiken
        </.link>
      </div>
    </div>

    <%!-- Capacity Bar --%>
    <% rate = @parking_status.occupancy_rate %>
      <div class={[
        "rounded-lg p-4 border flex items-center gap-4",
        cond do
          rate >= 95 -> "bg-red-950 border-red-700"
          rate >= 80 -> "bg-yellow-950 border-yellow-700"
          true -> "bg-gray-800 border-gray-700"
        end
      ]}>
        <span class={[
          "material-icons text-2xl leading-none",
          cond do
            rate >= 95 -> "text-red-400"
            rate >= 80 -> "text-yellow-400"
            true -> "text-green-400"
          end
        ]}>
          local_parking
        </span>
        <div class="flex-1">
          <div class="flex items-center justify-between mb-2">
            <span class="text-gray-300 text-sm font-medium">Gästeplätze</span>
            <div class="flex items-center gap-3">
              <span class="text-gray-400 text-sm">
                {@parking_status.available_spots} frei von {@parking_status.total_spots}
              </span>
              <span class={[
                "text-lg font-bold",
                cond do
                  rate >= 95 -> "text-red-400"
                  rate >= 80 -> "text-yellow-400"
                  true -> "text-green-400"
                end
              ]}>
                {rate}%
              </span>
              <%= cond do %>
                <% rate >= 95 -> %>
                  <span class="text-xs font-bold text-red-300 bg-red-900 border border-red-700 rounded px-2 py-0.5">
                    Voll
                  </span>
                <% rate >= 80 -> %>
                  <span class="text-xs font-bold text-yellow-300 bg-yellow-900 border border-yellow-700 rounded px-2 py-0.5">
                    Fast voll
                  </span>
                <% true -> %>
              <% end %>
            </div>
          </div>
          <div class="w-full bg-gray-700 rounded-full h-2.5 overflow-hidden">
            <div
              class={[
                "h-full rounded-full transition-all duration-300",
                cond do
                  rate >= 95 -> "bg-red-500"
                  rate >= 80 -> "bg-yellow-500"
                  true -> "bg-green-500"
                end
              ]}
              style={"width: #{rate}%"}
            >
            </div>
          </div>
        </div>
      </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <%!-- Left Panel: Actions --%>
      <div class="md:col-span-1 space-y-6">
        <%= if @authenticated_permanent_user == nil do %>
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h2 class="text-xl font-bold text-gray-100 mb-6">Aktionen</h2>

            <div class="space-y-3">
              <button
                phx-click="enter"
                disabled={@ticket != nil and @ticket.exit_time == nil}
                class={[
                  "w-full font-bold py-3 px-4 rounded-lg transition duration-200",
                  (@ticket != nil and @ticket.exit_time == nil) &&
                    "bg-gray-700 text-gray-500 cursor-not-allowed",
                  (@ticket == nil or @ticket.exit_time != nil) &&
                    "bg-green-600 hover:bg-green-700 text-white"
                ]}
              >
                <span class="material-icons align-middle text-base leading-none mr-1">login</span>Einfahrt
              </button>

              <button
                phx-click="pay"
                disabled={@ticket == nil or @ticket_paid}
                class={[
                  "w-full font-bold py-3 px-4 rounded-lg transition duration-200",
                  (@ticket == nil or @ticket_paid) &&
                    "bg-gray-700 text-gray-500 cursor-not-allowed",
                  (@ticket != nil and not @ticket_paid) &&
                    "bg-blue-600 hover:bg-blue-700 text-white"
                ]}
              >
                <span class="material-icons align-middle text-base leading-none mr-1">credit_card</span>Bezahlen
              </button>

              <button
                phx-click="exit"
                disabled={@ticket == nil or not @ticket_paid or @ticket.exit_time != nil}
                class={[
                  "w-full font-bold py-3 px-4 rounded-lg transition duration-200",
                  (@ticket == nil or not @ticket_paid or @ticket.exit_time != nil) &&
                    "bg-gray-700 text-gray-500 cursor-not-allowed",
                  (@ticket != nil and @ticket_paid and @ticket.exit_time == nil) &&
                    "bg-orange-600 hover:bg-orange-700 text-white"
                ]}
              >
                <span class="material-icons align-middle text-base leading-none mr-1">logout</span>Ausfahrt
              </button>
            </div>
          </div>
        <% end %>

        <%!-- Permanent User Authentication --%>
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
          <h3 class="text-lg font-bold text-gray-100 mb-4">Permanente Nutzerkarte</h3>
          <.form
            for={to_form(%{})}
            id="authenticate-card-form"
            phx-submit="authenticate_card"
            class="space-y-3"
          >
            <.input
              type="text"
              id="card-uuid"
              name="card_uuid"
              label="Karten UUID"
              placeholder="z.B. 123e4567-e89b-12d3-a456-426614174000"
              class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              required
            />
            <button
              type="submit"
              class="w-full bg-yellow-600 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded-lg transition duration-200"
            >
              <span class="material-icons align-middle text-base leading-none mr-1">
                qr_code_scanner
              </span>
              Karte authentifizieren
            </button>
          </.form>

          <%= if @authenticated_permanent_user do %>
            <div class="mt-4 space-y-3">
              <button
                phx-click="permanent_enter"
                class={[
                  "w-full font-bold py-3 px-4 rounded-lg transition duration-200",
                  @perm_user_parked && "bg-gray-700 text-gray-500 cursor-not-allowed",
                  not @perm_user_parked && "bg-teal-600 hover:bg-teal-700 text-white"
                ]}
                disabled={@perm_user_parked}
              >
                Einfahrt (Dauerparker)
              </button>

              <button
                phx-click="permanent_exit"
                class={[
                  "w-full font-bold py-3 px-4 rounded-lg transition duration-200",
                  not @perm_user_parked && "bg-gray-700 text-gray-500 cursor-not-allowed",
                  @perm_user_parked && "bg-orange-600 hover:bg-orange-700 text-white"
                ]}
                disabled={not @perm_user_parked}
              >
                Ausfahrt (Dauerparker)
              </button>

              <button
                phx-click="logout_user"
                class="w-full bg-gray-600 hover:bg-gray-500 text-white font-bold py-3 px-4 rounded-lg transition duration-200"
              >
                <span class="material-icons align-middle text-base leading-none mr-1">logout</span>Abmelden
              </button>
            </div>
          <% end %>

          <p class="text-xs text-gray-400 mt-2">
            Nur permanente Nutzer haben eine Karte. Erfassen Sie die UUID-Kartennummer hier.
          </p>
        </div>

        <%!-- Ticket Scanner --%>
        <%= if @authenticated_permanent_user == nil do %>
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-lg font-bold text-gray-100 mb-4">Ticket Scanner</h3>
            <.form
              for={to_form(%{})}
              id="scan-ticket-form"
              phx-submit="scan_ticket"
              class="space-y-3"
            >
              <.input
                type="text"
                id="ticket-uuid"
                name="uuid"
                label="Ticket UUID"
                placeholder="z.B. 123e4567-e89b-12d3-a456-426614174000"
                class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                required
              />
              <button
                type="submit"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded-lg transition duration-200"
              >
                <span class="material-icons align-middle text-base leading-none mr-1">qr_code_scanner</span>Ticket laden
              </button>
            </.form>
            <p class="text-xs text-gray-400 mt-2">
              Scannen Sie ein Ticket, um es zu laden. Anschliessend bezahlen und Ausfahrt registrieren.
            </p>
          </div>
        <% end %>
      </div>

      <%!-- Right Panel: Ticket Information --%>
      <div class="md:col-span-2">
        <%!-- Status Message --%>
        <%= if @message do %>
          <div class={[
            "rounded-lg p-4 mb-6 border",
            if(String.contains?(@message, ["Fehler", "fehlgeschlagen"]),
              do: "bg-red-900 border-red-700 text-red-100",
              else: "bg-green-900 border-green-700 text-green-100"
            )
          ]}>
            <div class="flex items-start">
              <span class="material-icons text-xl mr-3 align-middle leading-none">
                {if String.contains?(@message, ["Fehler", "fehlgeschlagen"]),
                  do: "warning",
                  else: "check_circle"}
              </span>
              <div>
                <p class="font-semibold">{@message}</p>
              </div>
            </div>
          </div>
        <% end %>

        <%= if @authenticated_permanent_user do %>
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 mb-6">
            <h2 class="text-xl font-bold text-gray-100 mb-4">Permanenter Nutzer</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              <div>
                <p class="text-gray-400 text-xs uppercase tracking-wider">Karten UUID</p>
                <p class="text-gray-100 font-mono mt-1 break-all">
                  {@authenticated_permanent_user.access_code}
                </p>
              </div>
              <div>
                <p class="text-gray-400 text-xs uppercase tracking-wider">Status</p>
                <p class={[
                  "mt-1 font-semibold",
                  if(@perm_user_parked, do: "text-green-400", else: "text-yellow-400")
                ]}>
                  {if @perm_user_parked, do: "Eingeparkt", else: "Bereit zum Einfahren"}
                </p>
              </div>
              <div class="sm:col-span-2">
                <p class="text-gray-400 text-xs uppercase tracking-wider">
                  Zugewiesener Stellplatz
                </p>
                <p class="text-gray-100 mt-1">
                  #{(@authenticated_permanent_user.spot && @authenticated_permanent_user.spot.number) ||
                    "Keine Zuweisung"}
                </p>
              </div>
            </div>
          </div>
        <% end %>

        <%!-- Current Ticket --%>
        <%= if @authenticated_permanent_user == nil do %>
          <%= if @ticket do %>
            <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
              <h2 class="text-xl font-bold text-gray-100 mb-6">Aktuelles Ticket</h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <%!-- Ticket ID --%>
                <div class="border-l-4 border-blue-500 pl-4">
                  <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">
                    Ticket ID
                  </p>
                  <p class="text-gray-100 font-mono text-sm mt-1 break-all">
                    {@ticket.id}
                  </p>
                </div>

                <%!-- Entry Time --%>
                <div class="border-l-4 border-green-500 pl-4">
                  <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">
                    Einfahrt
                  </p>
                  <p class="text-gray-100 text-sm mt-1">
                    <%= if @ticket.entry_time do %>
                      <time>{Calendar.strftime(@ticket.entry_time, "%d.%m.%Y %H:%M")}</time>
                    <% else %>
                      —
                    <% end %>
                  </p>
                </div>

                <%!-- Exit Time (if exists) --%>
                <%= if @ticket.exit_time do %>
                  <div class="border-l-4 border-orange-500 pl-4">
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">
                      Ausfahrt
                    </p>
                    <p class="text-gray-100 text-sm mt-1">
                      <time>{Calendar.strftime(@ticket.exit_time, "%d.%m.%Y %H:%M")}</time>
                    </p>
                  </div>
                <% end %>

                <%!-- Parking Spot --%>
                <div class="border-l-4 border-purple-500 pl-4">
                  <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">
                    Parkplatz
                  </p>
                  <p class="text-gray-100 text-sm mt-1">Stellplatz #{@ticket.spot.number}</p>
                </div>

                <%!-- Payment Status --%>
                <div class={[
                  "border-l-4 pl-4",
                  if(@ticket_paid, do: "border-green-500", else: "border-red-500")
                ]}>
                  <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">
                    Bezahlungsstatus
                  </p>
                  <div class="flex items-center mt-1 space-x-2">
                    <span class={[
                      "w-2 h-2 rounded-full",
                      if(@ticket_paid, do: "bg-green-500", else: "bg-red-500")
                    ]}>
                    </span>
                    <p class="text-gray-100 text-sm font-semibold">
                      {if @ticket_paid, do: "Bezahlt", else: "Ausstehend"}
                    </p>
                  </div>
                </div>

                <%= if @current_fee != nil and not @ticket_paid do %>
                  <div class="border-l-4 border-yellow-400 pl-4">
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">
                      Aktueller Betrag
                    </p>
                    <p class="text-yellow-300 text-lg font-bold mt-1">
                      CHF {:erlang.float_to_binary(@current_fee * 1.0, decimals: 2)}
                    </p>
                  </div>
                <% end %>

                <%= if @fee do %>
                  <div class="border-l-4 border-yellow-500 pl-4">
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">
                      Bezahlter Betrag
                    </p>
                    <p class="text-yellow-300 text-lg font-bold mt-1">
                      CHF {:erlang.float_to_binary(Decimal.to_float(@fee), decimals: 2)}
                    </p>
                  </div>
                <% end %>
              </div>

              <%!-- Duration Display (if exit time exists) --%>
              <%= if @ticket.exit_time do %>
                <div class="mt-6 pt-6 border-t border-gray-700">
                  <div class="bg-gray-700 rounded p-4 text-center">
                    <p class="text-gray-400 text-sm mb-2">Parkdauer</p>
                    <p class="text-gray-100 font-bold text-lg">
                      {duration_in_hours(@ticket)}h
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="bg-gray-800 rounded-lg p-12 border border-gray-700 border-dashed text-center">
              <p class="text-gray-400 text-lg">Kein aktives Ticket</p>
              <p class="text-gray-500 text-sm mt-2">Klicken Sie auf "Einfahrt", um zu beginnen</p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
